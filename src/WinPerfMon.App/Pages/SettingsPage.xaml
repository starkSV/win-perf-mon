<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPerfMon.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16" MaxWidth="600">

            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Theme -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ComboBox x:Name="ThemePicker" Header="Theme" Width="200">
                        <ComboBoxItem Content="System default" Tag="Default"/>
                        <ComboBoxItem Content="Light" Tag="Light"/>
                        <ComboBoxItem Content="Dark" Tag="Dark"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Data retention -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="History" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ComboBox x:Name="RetentionPicker" Header="Keep metric history for" Width="200">
                        <ComboBoxItem Content="1 hour"  Tag="1"/>
                        <ComboBoxItem Content="6 hours" Tag="6"/>
                        <ComboBoxItem Content="1 day"   Tag="24"/>
                        <ComboBoxItem Content="7 days"  Tag="168" IsSelected="True"/>
                        <ComboBoxItem Content="30 days" Tag="720"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Custom ping -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Network" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBox x:Name="PingTargetBox" Header="Custom ping target (hostname or IP)"
                             PlaceholderText="e.g. 8.8.8.8 or example.com" Width="300"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
