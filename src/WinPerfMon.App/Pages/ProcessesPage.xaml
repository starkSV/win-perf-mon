<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPerfMon.App.Pages.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinPerfMon.Shared.Models">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ── Toolbar ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Padding="16,12" ColumnSpacing="12"
              ColumnDefinitions="*,Auto,Auto">

            <AutoSuggestBox Grid.Column="0"
                x:Name="SearchBox"
                PlaceholderText="Filter by name, PID, or description..."
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="ProcessCountText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ThreadCountText"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Button Grid.Column="2" x:Name="EndTaskButton"
                Content="End task"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}"
                Click="EndTaskButton_Click"/>
        </Grid>

        <!-- ── Column headers (clickable for sort) ───────────────────── -->
        <Grid Grid.Row="1" Padding="16,0,16,4" ColumnSpacing="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              ColumnDefinitions="32,*,80,100,80,80,80,80">

            <TextBlock Grid.Column="0"/>

            <Button Grid.Column="1" x:Name="SortName"
                Content="Name ↕" Click="SortName_Click"
                Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left"/>

            <Button Grid.Column="2" x:Name="SortPid"
                Content="PID" Click="SortPid_Click"
                Style="{StaticResource SubtleButtonStyle}"/>

            <Button Grid.Column="3" x:Name="SortCpu"
                Content="CPU %" Click="SortCpu_Click"
                Style="{StaticResource SubtleButtonStyle}"/>

            <Button Grid.Column="4" x:Name="SortMemory"
                Content="Memory" Click="SortMemory_Click"
                Style="{StaticResource SubtleButtonStyle}"/>

            <Button Grid.Column="5" x:Name="SortDisk"
                Content="Disk" Click="SortDisk_Click"
                Style="{StaticResource SubtleButtonStyle}"/>

            <Button Grid.Column="6" x:Name="SortNetwork"
                Content="Network" Click="SortNetwork_Click"
                Style="{StaticResource SubtleButtonStyle}"/>

            <Button Grid.Column="7" x:Name="SortGpu"
                Content="GPU %" Click="SortGpu_Click"
                Style="{StaticResource SubtleButtonStyle}"/>
        </Grid>

        <!-- ── Process list ───────────────────────────────────────────── -->
        <ListView Grid.Row="2"
            x:Name="ProcessList"
            SelectionMode="Single"
            SelectionChanged="ProcessList_SelectionChanged"
            RightTapped="ProcessList_RightTapped">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="32"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProcessEntry">
                    <Grid ColumnSpacing="0" Padding="16,0"
                          ColumnDefinitions="32,*,80,100,80,80,80,80">

                        <!-- Expand icon placeholder (process tree v2) -->
                        <TextBlock Grid.Column="0" Text="›"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                        <!-- Name + description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Name}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Description}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{x:Bind Pid}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"/>

                        <!-- CPU — colored by load -->
                        <TextBlock Grid.Column="3"
                            Text="{x:Bind CpuPercent, Converter={StaticResource CpuPercentConverter}}"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{x:Bind CpuPercent, Converter={StaticResource LoadColorConverter}}"/>

                        <TextBlock Grid.Column="4" Text="{x:Bind WorkingSetDisplay}"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"/>

                        <TextBlock Grid.Column="5" Text="{x:Bind DiskDisplay}"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Grid.Column="6" Text="{x:Bind NetworkDisplay}"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Grid.Column="7"
                            Text="{x:Bind GpuPercent, Converter={StaticResource CpuPercentConverter}}"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ── Context menu (attached to ProcessList) ─────────────────── -->
        <ListView.Resources>
            <MenuFlyout x:Name="ProcessContextMenu" x:Key="ProcessContextMenu">
                <MenuFlyoutItem x:Name="MenuEndTask"   Text="End task"          Click="MenuEndTask_Click"/>
                <MenuFlyoutItem x:Name="MenuOpenPath"  Text="Open file location" Click="MenuOpenPath_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutSubItem Text="Set priority">
                    <MenuFlyoutItem Tag="Realtime"    Text="Real time"     Click="MenuPriority_Click"/>
                    <MenuFlyoutItem Tag="High"        Text="High"          Click="MenuPriority_Click"/>
                    <MenuFlyoutItem Tag="AboveNormal" Text="Above normal"  Click="MenuPriority_Click"/>
                    <MenuFlyoutItem Tag="Normal"      Text="Normal"        Click="MenuPriority_Click"/>
                    <MenuFlyoutItem Tag="BelowNormal" Text="Below normal"  Click="MenuPriority_Click"/>
                    <MenuFlyoutItem Tag="Idle"        Text="Low"           Click="MenuPriority_Click"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="MenuAffinity" Text="Set affinity…"  Click="MenuAffinity_Click"/>
            </MenuFlyout>
        </ListView.Resources>

        <!-- ── Status bar ─────────────────────────────────────────────── -->
        <Border Grid.Row="3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SelectedProcessInfo"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                    x:Name="StatusSummary"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Page>
