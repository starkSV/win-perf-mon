<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPerfMon.App.Pages.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="12">

            <TextBlock Text="Physical Disks" Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <ItemsRepeater x:Name="DiskRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">

                                <!-- Header row -->
                                <Grid>
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Model}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{Binding Type}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" CornerRadius="4" Padding="8,4"
                                            Background="{Binding Health, Converter={StaticResource HealthColorConverter}}">
                                        <TextBlock Text="{Binding Health}" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- I/O stats -->
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Read" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ReadBytesPerSec, Converter={StaticResource BytesConverter}}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Write" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding WriteBytesPerSec, Converter={StaticResource BytesConverter}}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Queue" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding QueueDepth, StringFormat='{}{0:F1}'}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                        <TextBlock Text="Active" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ProgressBar Value="{Binding ActiveTimePercent}" Maximum="100" Width="120"/>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>
