<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPerfMon.App.Pages.CpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16">

            <!-- Top stats row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Total Load" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TotalLoadText" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Package Temp" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PackageTempText" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Processes" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ProcessCountText" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Threads" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ThreadCountText" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 60-second history chart -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Load History (60s)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>
                    <lvc:CartesianChart x:Name="LoadChart" Height="160"/>
                </StackPanel>
            </Border>

            <!-- Per-core grid -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Per-Core" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12"/>
                    <ItemsRepeater x:Name="CoresRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="200" MinColumnSpacing="8" MinRowSpacing="8"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Index, Converter={StaticResource CoreIndexConverter}}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <ProgressBar Value="{Binding Load}" Maximum="100" Height="6"/>
                                        <Grid>
                                            <TextBlock Text="{Binding Load, StringFormat='{}{0:F0}%'}" HorizontalAlignment="Left" Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <TextBlock Text="{Binding FrequencyMhz, StringFormat='{}{0:F0} MHz'}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
